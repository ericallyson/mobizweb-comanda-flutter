    <!-- Fundo atrás da interface Flutter depois de iniciada. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/mobiz_navy</item>
    </style>
</resources>
